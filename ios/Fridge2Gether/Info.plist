	<string>Take a photo of your groceries so Fridge2Gether can add them to your fridge.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a photo of your groceries to add them to your fridge.</string>
	<key>UIAppFonts</key>
	<array>
		<string>PatrickHand-Regular.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
