rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(fridgeId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/fridges/$(fridgeId)).data.memberIds;
    }

    // Each person's profile: name + which fridge they belong to.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /fridges/{fridgeId} {
      // Signed-in users can look up a fridge by invite code.
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      // Members can edit; anyone signed in can add or remove only themselves.
      allow update: if isMember(fridgeId) || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberNames'])
      );

      match /foods/{foodId} {
        allow read, write: if isMember(fridgeId);
      }

      match /offers/{offerId} {
        allow read, write: if isMember(fridgeId);
      }
    }
  }
}
