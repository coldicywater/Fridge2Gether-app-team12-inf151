rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(fridgeId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/fridges/$(fridgeId)).data.memberIds;
    }

    // Each person's profile: name + which fridge they belong to.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /fridges/{fridgeId} {
      // Members can open their fridge. Anyone signed in can look one up by invite code,
      // one result at a time, so the list of fridges can't be dumped in one query.
      allow get: if signedIn() && (request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.query.limit <= 1;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      // Members can edit. A non-member (joining with the code) can only add themselves:
      // the member list must be the old list plus their own uid, and only their own name changes.
      allow update: if isMember(fridgeId) || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberNames']) &&
        request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet()) &&
        request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
      );

      match /foods/{foodId} {
        allow read, write: if isMember(fridgeId);
      }

      match /offers/{offerId} {
        allow read, write: if isMember(fridgeId);
      }

      // Fridge group chat. You can only post as yourself; the only edit allowed
      // is answering a request ("I've got it"). Messages can't be deleted.
      match /messages/{messageId} {
        allow read: if isMember(fridgeId);
        allow create: if isMember(fridgeId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isMember(fridgeId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fulfilledById', 'fulfilledByName']);
      }
    }
  }
}
